# Scenario-side migration of git-cgallagher/ansible-collection-isc to the molecule-git-cgallagher driver.
# Base: isc main 9d20478 (2026-10-31). Apply with: git apply docs/isc-scenarios.patch
# Workflows, galaxy.yml build_ignore, the version-bump regex and docs are not included:
# see docs/MIGRATION.md.
diff --git a/.config/molecule/config.yml b/.config/molecule/config.yml
new file mode 100644
index 0000000..0cac0c1
--- /dev/null
+++ b/.config/molecule/config.yml
@@ -0,0 +1,19 @@
+---
+# Base config Molecule merges under every scenario (roles/<role>/molecule/*),
+# so each molecule.yml only defines platforms and inventory. Molecule runs
+# from the role directory: ${MOLECULE_PROJECT_DIRECTORY}/../.. is the repo root.
+dependency:
+  name: galaxy
+  options:
+    requirements-file: ${MOLECULE_PROJECT_DIRECTORY}/../../requirements.yml
+driver:
+  name: molecule-git-cgallagher
+provisioner:
+  name: ansible
+  env:
+    # Expose this checkout as git_cgallagher.isc (see AGENTS.md).
+    ANSIBLE_COLLECTIONS_PATH: ${MOLECULE_PROJECT_DIRECTORY}/../../.molecule-collections:${MOLECULE_PROJECT_DIRECTORY}/../../collections:~/.ansible/collections
+verifier:
+  name: ansible
+scenario:
+  test_sequence: [dependency, destroy, syntax, create, prepare, converge, idempotence, verify, destroy]
